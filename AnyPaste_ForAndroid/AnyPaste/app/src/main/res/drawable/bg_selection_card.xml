<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent_hover" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="2dp" android:color="@color/sk_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_press" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
