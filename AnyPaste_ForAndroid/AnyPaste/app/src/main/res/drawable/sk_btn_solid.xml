<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_muted" />
            <corners android:radius="@dimen/sk_r_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_solid_pressed" />
            <corners android:radius="@dimen/sk_r_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_solid" />
            <corners android:radius="@dimen/sk_r_md" />
        </shape>
    </item>
</selector>
