<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_elevated"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item android:state_checked="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent_hover"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent_hover"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item android:state_activated="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent_hover"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_accent"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_elevated"/>
            <corners android:radius="@dimen/sk_r_lg"/>
            <stroke android:width="2dp" android:color="@color/sk_focus"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_press"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_elevated"/>
            <corners android:radius="@dimen/sk_r_lg"/>
        </shape>
    </item>
</selector>
