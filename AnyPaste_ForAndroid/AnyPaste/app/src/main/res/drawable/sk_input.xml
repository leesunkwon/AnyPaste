<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_muted"/>
            <corners android:radius="@dimen/sk_r_md"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_elevated"/>
            <corners android:radius="@dimen/sk_r_md"/>
            <stroke android:width="2dp" android:color="@color/sk_focus"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_elevated"/>
            <corners android:radius="@dimen/sk_r_md"/>
            <stroke android:width="2dp" android:color="@color/sk_focus"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_elevated"/>
            <corners android:radius="@dimen/sk_r_md"/>
            <stroke android:width="1dp" android:color="@color/line"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_elevated"/>
            <corners android:radius="@dimen/sk_r_md"/>
            <stroke android:width="1dp" android:color="@color/line"/>
        </shape>
    </item>
</selector>
