<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_bg_muted"/>
            <corners android:radius="@dimen/sk_r_full"/>
            <size android:width="@dimen/sk_switch_w" android:height="@dimen/sk_switch_h"/>
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_solid"/>
            <corners android:radius="@dimen/sk_r_full"/>
            <size android:width="@dimen/sk_switch_w" android:height="@dimen/sk_switch_h"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sk_switch_off"/>
            <corners android:radius="@dimen/sk_r_full"/>
            <size android:width="@dimen/sk_switch_w" android:height="@dimen/sk_switch_h"/>
        </shape>
    </item>
</selector>
