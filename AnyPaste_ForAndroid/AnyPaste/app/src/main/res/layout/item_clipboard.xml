<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_clipboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_12"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12">

    <ImageView
        android:id="@+id/iv_clipboard_type"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_icon_primary"
        android:contentDescription="클립보드 항목 유형"
        android:padding="11dp"
        android:src="@drawable/ic_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_clipboard_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_clipboard_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textColor="@color/ink_secondary"
            android:textSize="12px" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_clipboard_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="상세"
        android:src="@drawable/ic_arrow_right" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/check_clipboard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
