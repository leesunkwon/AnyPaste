<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_device"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_10"
    android:background="@drawable/bg_dashboard_card"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/dashboard_press"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_16">

    <ImageView
        android:id="@+id/iv_device_type"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_dashboard_type"
        android:contentDescription="기기 유형"
        android:padding="14dp"
        android:src="@drawable/ic_phone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_device_name"
            style="@style/TextAppearance.AnyPaste.BodyStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_device_meta"
            style="@style/TextAppearance.AnyPaste.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_device_status_chip"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_dashboard_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_10">

        <View
            android:id="@+id/view_device_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle_success" />

        <TextView
            android:id="@+id/tv_device_status"
            style="@style/TextAppearance.AnyPaste.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_6"
            android:textColor="@color/success_foreground"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
