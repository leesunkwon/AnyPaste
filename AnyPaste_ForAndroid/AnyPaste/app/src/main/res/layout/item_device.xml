<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_device"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_10"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_14">

    <ImageView
        android:id="@+id/iv_device_type"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_primary"
        android:contentDescription="기기 유형"
        android:padding="12dp"
        android:src="@drawable/ic_phone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_device_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_device_status_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingVertical="@dimen/space_4">

        <TextView
            android:id="@+id/view_device_status"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle_success" />

        <TextView
            android:id="@+id/tv_device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:textColor="@color/success_foreground"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
