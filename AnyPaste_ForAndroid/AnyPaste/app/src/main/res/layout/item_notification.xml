<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_12"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12">

    <ImageView
        android:id="@+id/iv_notification_type"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_primary"
        android:contentDescription="알림 유형"
        android:padding="10dp"
        android:src="@drawable/ic_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_notification_body"
            style="@style/TextAppearance.ViaOs.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12px" />

        <TextView
            android:id="@+id/tv_notification_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/ink_tertiary"
            android:textSize="11px" />
    </LinearLayout>

    <TextView
        android:id="@+id/view_notification_unread"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_circle_primary" />
</LinearLayout>
