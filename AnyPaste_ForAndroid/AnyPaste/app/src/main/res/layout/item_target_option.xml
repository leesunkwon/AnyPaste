<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_target_option"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="@dimen/space_8"
    android:background="@drawable/bg_dashboard_type"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/dashboard_press"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16">

    <ImageView
        android:id="@+id/iv_target_option"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription=""
        android:src="@drawable/ic_devices"
        android:tint="@color/ink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_target_option_title"
            style="@style/TextAppearance.AnyPaste.BodyStrong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_target_option_meta"
            style="@style/TextAppearance.AnyPaste.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <View
        android:id="@+id/view_target_option_selected"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_circle_neutral" />
</LinearLayout>
