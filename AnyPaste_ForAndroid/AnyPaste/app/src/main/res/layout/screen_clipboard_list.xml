<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_20"
    android:paddingTop="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_primary"
            android:contentDescription="뒤로가기"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:text="최근 항목"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_select_clipboards"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="선택"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filter_all"
                android:layout_width="60dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_card_primary"
                android:gravity="center"
                android:text="전체"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filter_text"
                android:layout_width="66dp"
                android:layout_height="34dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center"
                android:text="텍스트"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filter_image"
                android:layout_width="66dp"
                android:layout_height="34dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center"
                android:text="이미지"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/filter_file"
                android:layout_width="60dp"
                android:layout_height="34dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center"
                android:text="파일"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layout_clipboard_selection_actions"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_selected_clipboard_count"
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0개 선택"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_select_all_clipboards"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="72dp"
            android:text="전체 선택"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_20">

            <ProgressBar
                android:id="@+id/progress_clipboards"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="@dimen/space_16"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_clipboards_empty"
                style="@style/TextAppearance.AnyPaste.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center"
                android:padding="@dimen/space_24"
                android:text="이 조건에 맞는 항목이 없어요."
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_clipboard_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_selected"
                style="@style/Widget.AnyPaste.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="선택 항목 삭제"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_card_warning"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="최근 항목은 기본 24시간 후 자동으로 삭제됩니다."
                    android:textColor="@color/warning"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="설정"
                    android:textColor="@color/warning"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
