<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_navigation_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_action"
            android:contentDescription="뒤로가기"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.AnyPaste.TopNavigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:text="기기 상세" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layout_device_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/screen_bottom_space">

            <ProgressBar
                android:id="@+id/progress_device_detail"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/primary_contrast"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_device_detail_type"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_icon_purple"
                android:contentDescription="MacBook Pro"
                android:padding="18dp"
                android:src="@drawable/ic_desktop" />

            <TextView
                android:id="@+id/tv_device_detail_name"
                style="@style/TextAppearance.AnyPaste.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="MacBook Pro"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/badge_device_detail_status"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_card_success"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_12">

                <TextView
                    android:id="@+id/view_device_detail_status"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle_success" />

                <TextView
                    android:id="@+id/tv_device_detail_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="온라인 · 동기화 가능"
                    android:textColor="@color/success_foreground"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:background="@drawable/bg_card_stroke"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    style="@style/TextAppearance.AnyPaste.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="기기 정보" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="플랫폼"
                        android:textColor="@color/ink_secondary" />

                    <TextView
                        android:id="@+id/tv_device_detail_platform"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="macOS 15.6"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="마지막 동기화"
                        android:textColor="@color/ink_secondary" />

                    <TextView
                        android:id="@+id/tv_device_detail_last_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="방금 전"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="연결된 날짜"
                        android:textColor="@color/ink_secondary" />

                    <TextView
                        android:id="@+id/tv_device_detail_connected_at"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026. 08. 22"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.AnyPaste.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:text="이 기기의 동기화" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="클립보드 자동 동기화"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.AnyPaste.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="새 텍스트와 이미지를 자동으로 받아요."
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    style="@style/Widget.AnyPaste.Switch"
                    android:id="@+id/switch_device_auto_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="파일 수신 알림"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.AnyPaste.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="새 파일이 도착하면 알려드려요."
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    style="@style/Widget.AnyPaste.Switch"
                    android:id="@+id/switch_device_file_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_rename_device"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center"
                android:text="기기 이름 변경"
                android:textColor="@color/primary_contrast"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_disconnect_device"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_action_critical"
                android:gravity="center"
                android:text="이 기기 연결 해제"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_device_detail_error"
                style="@style/TextAppearance.AnyPaste.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:textColor="@color/danger_foreground"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
