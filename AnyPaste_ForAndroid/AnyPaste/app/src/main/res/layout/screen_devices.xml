<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/layout_devices_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/screen_bottom_space">

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE NETWORK" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.AnyPaste.ScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="내 기기" />

            <TextView
                android:id="@+id/btn_add_device"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_dashboard_hero"
                android:contentDescription="기기 연결 추가"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/on_primary_container"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/bg_dashboard_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_20">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_devices_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0대"
                    android:textColor="@color/ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_devices_summary"
                    style="@style/TextAppearance.AnyPaste.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="연결된 기기를 불러오는 중"
                    android:textColor="@color/ink_secondary" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_dashboard_chip">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="연결된 기기"
                    android:src="@drawable/ic_devices"
                    android:tint="@color/app_positive" />

                <View
                    android:id="@+id/view_devices_summary_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="end|bottom"
                    android:background="@drawable/bg_circle_success" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.AnyPaste.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_28"
            android:text="연결된 기기" />

        <ProgressBar
            android:id="@+id/progress_devices"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_24"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_devices_empty"
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_dashboard_card"
            android:gravity="center"
            android:padding="@dimen/space_24"
            android:text="아직 연결된 다른 기기가 없어요.\n아래 버튼으로 새 기기를 연결해 보세요."
            android:textAlignment="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_device_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_connect_device"
            style="@style/Widget.AnyPaste.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="새 기기 연결" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:text="같은 계정으로 로그인한 기기만 표시됩니다."
            android:textAlignment="center" />
    </LinearLayout>
</ScrollView>
