<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_20"
        android:paddingBottom="@dimen/screen_bottom_space">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_action"
            android:contentDescription="뒤로가기"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.AnyPaste.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nav_title_gap"
            android:text="이메일 로그인" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="가입한 이메일과 비밀번호로 로그인해 주세요."
            android:textSize="16sp" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="이메일" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AnyPaste.TextInputLayout"
            android:id="@+id/layout_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AnyPaste.TextInputEditText"
                android:id="@+id/input_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_gap"
            android:text="비밀번호" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AnyPaste.TextInputLayout"
            android:id="@+id/layout_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AnyPaste.TextInputEditText"
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:hint="비밀번호 입력"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/btn_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:text="비밀번호를 잊으셨나요?"
            android:textColor="@color/primary_contrast"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_auth_error"
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/danger_foreground"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_card_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="안전한 로그인"
                android:src="@drawable/ic_shield"
                android:tint="@color/on_primary_container" />

            <TextView
                style="@style/TextAppearance.AnyPaste.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="계정과 동기화 데이터는 안전하게 보호됩니다."
                android:textColor="@color/on_primary_container"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_email_continue"
            style="@style/Widget.AnyPaste.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:onClick="submitEmailLogin"
            android:text="로그인" />

        <TextView
            android:id="@+id/btn_sign_up"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="계정이 없으신가요? 회원가입"
            android:textColor="@color/primary_contrast"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_auth"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:indeterminateTint="@color/primary_contrast"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
