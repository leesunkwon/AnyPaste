<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_primary"
            android:contentDescription="뒤로가기"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="이메일 로그인"
            android:textSize="27sp" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="가입한 이메일과 비밀번호로 로그인해 주세요."
            android:textSize="15sp" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="이메일"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:boxBackgroundColor="@color/surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="@dimen/radius_s"
            app:boxCornerRadiusBottomStart="@dimen/radius_s"
            app:boxCornerRadiusTopEnd="@dimen/radius_s"
            app:boxCornerRadiusTopStart="@dimen/radius_s"
            app:boxStrokeColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="name@example.com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="비밀번호"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:boxBackgroundColor="@color/surface"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="@dimen/radius_s"
            app:boxCornerRadiusBottomStart="@dimen/radius_s"
            app:boxCornerRadiusTopEnd="@dimen/radius_s"
            app:boxCornerRadiusTopStart="@dimen/radius_s"
            app:boxStrokeColor="@color/primary"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="비밀번호 입력"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/btn_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:text="비밀번호를 잊으셨나요?"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_auth_error"
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textColor="@color/warning"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_card_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="안전한 로그인"
                android:src="@drawable/ic_shield" />

            <TextView
                style="@style/TextAppearance.AnyPaste.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="계정과 동기화 데이터는 안전하게 보호됩니다."
                android:textColor="@color/on_primary_container"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_email_continue"
            style="@style/Widget.AnyPaste.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="로그인" />

        <TextView
            android:id="@+id/btn_sign_up"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="계정이 없으신가요? 회원가입"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_auth"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
