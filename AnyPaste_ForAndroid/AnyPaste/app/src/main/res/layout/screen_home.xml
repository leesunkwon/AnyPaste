<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_navigation_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.AnyPaste.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="홈" />

        <ImageButton
            android:id="@+id/btn_notifications"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_action"
            android:contentDescription="알림"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_bell" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_20"
            android:paddingBottom="@dimen/space_24">

            <TextView
                style="@style/TextAppearance.AnyPaste.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="최근 항목" />

            <ProgressBar
                android:id="@+id/progress_home_recent"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:indeterminateTint="@color/primary_contrast"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_home_recent_empty"
                style="@style/TextAppearance.AnyPaste.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:paddingVertical="@dimen/space_32"
                android:text="아직 전송된 항목이 없어요."
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/item_clipboard_first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_clipboard_first_type"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_icon_primary"
                        android:contentDescription="전송 항목 유형"
                        android:padding="@dimen/space_12"
                        android:src="@drawable/ic_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_clipboard_first_title"
                            style="@style/TextAppearance.AnyPaste.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="전송한 항목"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tv_clipboard_first_meta"
                            style="@style/TextAppearance.AnyPaste.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:ellipsize="end"
                            android:maxLines="1" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="상세 보기"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_home_clipboard_preview"
                    style="@style/TextAppearance.AnyPaste.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_home_clipboard_primary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="복사"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_home_clipboard_detail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="상세 보기"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.AnyPaste.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="새로 보내기" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_send_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_icon_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="텍스트 보내기"
                        android:src="@drawable/ic_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="텍스트"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/btn_send_image"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_icon_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="이미지 보내기"
                        android:src="@drawable/ic_image" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="이미지"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/btn_send_file"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_icon_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="파일 보내기"
                        android:src="@drawable/ic_file" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="파일"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.AnyPaste.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:lineSpacingExtra="2dp"
                android:text="새 항목을 보내면 기존 항목은 교체되고, 5분 뒤 자동으로 사라집니다." />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
