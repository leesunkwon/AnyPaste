<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp">

    <TextView
        style="@style/TextAppearance.AnyPaste.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW TRANSFER" />

    <TextView
        style="@style/TextAppearance.AnyPaste.ScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="보내기" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/TextAppearance.AnyPaste.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="보낼 항목" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_type_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_type"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_text"
                        android:tint="@color/selection_content" />

                    <TextView
                        android:id="@+id/tv_type_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:duplicateParentState="true"
                        android:text="텍스트"
                        android:textColor="@color/selection_content"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_type_image"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_type"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_image"
                        android:tint="@color/selection_content" />

                    <TextView
                        android:id="@+id/tv_type_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:duplicateParentState="true"
                        android:text="이미지"
                        android:textColor="@color/selection_content"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_type_file"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_type"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_file"
                        android:tint="@color/selection_content" />

                    <TextView
                        android:id="@+id/tv_type_file"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:duplicateParentState="true"
                        android:text="파일"
                        android:textColor="@color/selection_content"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.AnyPaste.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="내용" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_send_text"
                style="@style/Widget.AnyPaste.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_send_text"
                    style="@style/Widget.AnyPaste.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="156dp"
                    android:gravity="top"
                    android:hint="보낼 내용을 입력해 주세요"
                    android:padding="16dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/card_select_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_send_file_type"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_dashboard_pink"
                    android:contentDescription="전송할 파일 선택"
                    android:padding="12dp"
                    android:src="@drawable/ic_file"
                    android:tint="@color/on_brand" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_send_file_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_send_file_info"
                        style="@style/TextAppearance.AnyPaste.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_select_file"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_dashboard_chip"
                    android:gravity="center"
                    android:text="열기"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_send_image_preview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_dashboard_card"
                android:contentDescription="전송 이미지 미리보기"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_send_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger_foreground"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/card_send_sensitive_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_pink"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="@color/on_brand"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="비밀번호와 인증번호는 보내지 마세요."
                    android:textColor="@color/on_brand"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.AnyPaste.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="받는 기기" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_send_target_all"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_type"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="전체 기기"
                    android:textColor="@color/selection_content"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_send_target_specific"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_type"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="특정 기기"
                    android:textColor="@color/selection_content"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_send_target_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dashboard_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_send_target_device"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_dashboard_green"
                    android:contentDescription="전송 대상 기기"
                    android:padding="10dp"
                    android:src="@drawable/ic_devices"
                    android:tint="@color/teal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_send_target_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink_tertiary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_send_target_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_send_target_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/success_foreground"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_send_target_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_send_target_selected"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_send_device_empty"
                style="@style/TextAppearance.AnyPaste.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="전송할 수 있는 다른 기기가 없어요."
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/card_send_expiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dashboard_pink"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_send_expiry_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_brand"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_send_expiry_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/on_brand"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_send_storage_policy"
                style="@style/TextAppearance.AnyPaste.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_transfer"
        style="@style/Widget.AnyPaste.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="보내기"
        app:icon="@drawable/ic_send"
        app:iconGravity="textStart" />

    <ProgressBar
        android:id="@+id/progress_send"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />
</LinearLayout>
