<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_20"
    android:paddingTop="@dimen/space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_primary"
            android:contentDescription="뒤로가기"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:text="새로 보내기"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_20">

            <TextView
                style="@style/TextAppearance.AnyPaste.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="보낼 항목"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_type_text"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="텍스트"
                        android:src="@drawable/ic_text" />

                    <TextView
                        android:id="@+id/tv_type_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="텍스트"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_type_image"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_stroke"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="이미지"
                        android:src="@drawable/ic_image" />

                    <TextView
                        android:id="@+id/tv_type_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="이미지"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_type_file"
                    android:layout_width="0dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_stroke"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="파일"
                        android:src="@drawable/ic_file" />

                    <TextView
                        android:id="@+id/tv_type_file"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="파일"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.AnyPaste.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:text="내용"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_send_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:boxBackgroundColor="@color/surface"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/radius_s"
                app:boxCornerRadiusBottomStart="@dimen/radius_s"
                app:boxCornerRadiusTopEnd="@dimen/radius_s"
                app:boxCornerRadiusTopStart="@dimen/radius_s"
                app:boxStrokeColor="@color/primary"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_send_text"
                    android:layout_width="match_parent"
                    android:layout_height="148dp"
                    android:gravity="top"
                    android:hint="보낼 내용을 입력해 주세요"
                    android:padding="@dimen/space_16"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/card_select_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_card_stroke"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_send_file_type"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_teal"
                    android:contentDescription="전송할 파일 선택"
                    android:padding="10dp"
                    android:src="@drawable/ic_file" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_send_file_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:text="파일을 선택해 주세요"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_send_file_info"
                        style="@style/TextAppearance.AnyPaste.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="이미지 또는 파일 탐색기에서 선택"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_select_file"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="선택"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_send_image_preview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/space_12"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_input"
                android:contentDescription="전송 이미지 미리보기"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_send_error"
                style="@style/TextAppearance.AnyPaste.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/card_send_sensitive_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_warning"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_12">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="@color/warning"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.AnyPaste.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:text="비밀번호, 인증번호 등 민감한 정보는 보내지 마세요."
                    android:textColor="@color/warning"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.AnyPaste.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:text="받는 기기"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/card_send_target_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_card_stroke"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <ImageView
                    android:id="@+id/iv_send_target_device"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icon_primary"
                    android:contentDescription="MacBook Pro"
                    android:padding="9dp"
                    android:src="@drawable/ic_desktop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_send_target_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MacBook Pro"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_send_target_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="온라인 · 즉시 전송 가능"
                        android:textColor="@color/success"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_send_target_selected"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="선택됨"
                    android:src="@drawable/ic_check" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_send_device_empty"
                style="@style/TextAppearance.AnyPaste.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center"
                android:padding="@dimen/space_20"
                android:text="전송할 수 있는 다른 기기가 없어요."
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_transfer"
        style="@style/Widget.AnyPaste.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/space_12"
        android:text="MacBook Pro로 보내기"
        app:icon="@drawable/ic_send"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />

    <ProgressBar
        android:id="@+id/progress_send"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />
</LinearLayout>
