<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_16">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.ViaOs.Title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_navigation_height"
                android:gravity="center_vertical"
                android:text="설정"
                android:textSize="24px" />

            <LinearLayout
                android:id="@+id/btn_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_16">

                <TextView
                    android:id="@+id/tv_settings_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_primary"
                    android:gravity="center"
                    android:text="수"
                    android:textColor="@color/white"
                    android:textSize="18px"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_settings_account_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수진"
                        android:textColor="@color/ink"
                        android:textSize="16px"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_settings_account_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="sujin@example.com"
                        android:textColor="@color/ink_secondary"
                        android:textSize="12px" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="계정 관리"
                    android:src="@drawable/ic_arrow_right" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.ViaOs.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:text="동기화" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="클립보드 자동 동기화"
                            android:textColor="@color/ink"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.ViaOs.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="앱을 열어 둔 동안 복사한 텍스트와 이미지를 자동으로 동기화"
                            android:textSize="12px" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        style="@style/Widget.ViaOs.Switch"
                        android:id="@+id/switch_auto_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                    android:checked="true" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.ViaOs.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_card_informative"
                    android:lineSpacingExtra="2dp"
                    android:padding="@dimen/space_12"
                    android:text="안내: Android 보안 정책에 따라 자동 동기화는 AnyPaste 화면이 열려 있을 때만 작동합니다. 앱을 다시 열면 마지막으로 복사한 항목을 확인해 동기화합니다."
                    android:textColor="@color/informative_foreground"
                    android:textSize="12px" />

                <TextView
                    style="@style/TextAppearance.ViaOs.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_card_informative"
                    android:lineSpacingExtra="2dp"
                    android:padding="@dimen/space_12"
                    android:text="보관 안내: 모든 항목은 5분 동안만 보관됩니다. 새 항목이 들어오면 기존 항목은 즉시 사라집니다."
                    android:textColor="@color/informative_foreground"
                    android:textSize="12px" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_16"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wi-Fi에서만 파일 전송"
                            android:textColor="@color/ink"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.ViaOs.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="모바일 데이터 사용을 줄여요"
                            android:textSize="12px" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        style="@style/Widget.ViaOs.Switch"
                        android:id="@+id/switch_wifi_only"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_background_sync_guidance"
                style="@style/TextAppearance.ViaOs.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_warning"
                android:padding="@dimen/space_16"
                android:textColor="@color/warning_foreground"
                android:textSize="12px"
                android:visibility="gone" />

            <TextView
                style="@style/TextAppearance.ViaOs.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:text="알림 및 개인정보" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_primary"
                        android:contentDescription="알림"
                        android:padding="8dp"
                        android:src="@drawable/ic_bell" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="수신 알림"
                            android:textColor="@color/ink"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.ViaOs.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="새 항목이 오면 알려드려요"
                            android:textSize="12px" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        style="@style/Widget.ViaOs.Switch"
                        android:id="@+id/switch_receive_notifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_16"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/btn_permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_icon_purple"
                        android:contentDescription="개인정보"
                        android:padding="8dp"
                        android:src="@drawable/ic_shield" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="권한 및 개인정보"
                            android:textColor="@color/ink"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.ViaOs.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="클립보드 동기화와 5분 보관 정책"
                            android:textSize="12px" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="권한 상세"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.ViaOs.Overline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_28"
                android:text="앱 정보" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:text="AnyPaste 1.0.0"
                android:textColor="@color/ink_secondary"
                android:textSize="13px" />

            <TextView
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_action_critical"
                android:gravity="center"
                android:text="로그아웃"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
