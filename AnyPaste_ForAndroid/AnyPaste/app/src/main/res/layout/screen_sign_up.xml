<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_20"
        android:paddingBottom="@dimen/screen_bottom_space">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_action"
            android:contentDescription="뒤로가기"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextAppearance.AnyPaste.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/nav_title_gap"
            android:text="회원가입" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="하나의 계정으로 내 기기의 클립보드를 연결해 보세요."
            android:textSize="16sp" />

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="이메일" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AnyPaste.TextInputLayout"
            android:id="@+id/layout_signup_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AnyPaste.TextInputEditText"
                android:id="@+id/input_signup_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:autofillHints="emailAddress"
                android:hint="name@example.com"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_gap"
            android:text="이름" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AnyPaste.TextInputLayout"
            android:id="@+id/layout_signup_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AnyPaste.TextInputEditText"
                android:id="@+id/input_signup_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:autofillHints="name"
                android:hint="사용할 이름"
                android:imeOptions="actionNext"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_gap"
            android:text="비밀번호" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AnyPaste.TextInputLayout"
            android:id="@+id/layout_signup_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AnyPaste.TextInputEditText"
                android:id="@+id/input_signup_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:autofillHints="newPassword"
                android:hint="8자 이상 입력"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.AnyPaste.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_gap"
            android:text="비밀번호 확인" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.AnyPaste.TextInputLayout"
            android:id="@+id/layout_signup_password_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.AnyPaste.TextInputEditText"
                android:id="@+id/input_signup_password_confirmation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_large"
                android:autofillHints="newPassword"
                android:hint="비밀번호 다시 입력"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_16"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_signup_error"
            style="@style/TextAppearance.AnyPaste.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/danger_foreground"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_account"
            style="@style/Widget.AnyPaste.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="회원가입" />

        <ProgressBar
            android:id="@+id/progress_signup"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:indeterminateTint="@color/primary_contrast"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_go_to_login"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:text="이미 계정이 있으신가요? 로그인"
            android:textColor="@color/primary_contrast"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
