<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sk_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/sk_screen_pad"
    android:paddingTop="@dimen/sk_s_3"
    android:paddingEnd="@dimen/sk_screen_pad"
    android:paddingBottom="@dimen/sk_safe_bottom">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/sk_sheet_handle"
        android:contentDescription="아래로 내려 닫기" />

    <TextView
        android:id="@+id/tv_bottom_sheet_title"
        style="@style/TextAppearance.Via.Title3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sk_s_5" />

    <TextView
        android:id="@+id/tv_bottom_sheet_body"
        style="@style/TextAppearance.Via.Body2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sk_s_2"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_bottom_sheet_name_layout"
        style="@style/Widget.ViaOs.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sk_s_5"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_bottom_sheet_name"
            style="@style/Widget.ViaOs.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="기기 이름 입력"
            android:hint="기기 이름"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/layout_bottom_sheet_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sk_s_5"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_bottom_sheet_primary"
        style="@style/Widget.ViaOs.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sk_s_5"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_bottom_sheet_secondary"
        style="@style/Widget.ViaOs.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sk_s_2"
        android:text="취소" />
</LinearLayout>
