<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_64"
    android:layout_marginTop="@dimen/space_12"
    android:background="@drawable/bg_nav"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_12">

    <ImageButton
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:contentDescription="최근 항목"
        android:padding="20dp"
        android:src="@drawable/ic_home"
        android:tint="@color/navigation_icon" />

    <ImageButton
        android:id="@+id/btn_send"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:contentDescription="보내기"
        android:padding="20dp"
        android:src="@drawable/ic_send"
        android:tint="@color/navigation_icon" />

    <ImageButton
        android:id="@+id/nav_devices"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:contentDescription="내 기기"
        android:padding="20dp"
        android:src="@drawable/ic_devices"
        android:tint="@color/navigation_icon" />

    <ImageButton
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:contentDescription="설정"
        android:padding="20dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/navigation_icon" />
</LinearLayout>
