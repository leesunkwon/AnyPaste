<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="@color/background"
    android:paddingHorizontal="20dp"
    android:paddingBottom="12dp"
    android:paddingTop="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_dashboard_dock"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_dock_item"
            android:clickable="true"
            android:contentDescription="홈"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_home"
                android:tint="@color/navigation_icon" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_dock_item"
            android:clickable="true"
            android:contentDescription="보내기"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_send"
                android:tint="@color/navigation_icon" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_devices"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_dock_item"
            android:clickable="true"
            android:contentDescription="기기"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_devices"
                android:tint="@color/navigation_icon" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_dock_item"
            android:clickable="true"
            android:contentDescription="설정"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_settings"
                android:tint="@color/navigation_icon" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
