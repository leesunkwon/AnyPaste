<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/sk_tabbar"
    android:background="@drawable/sk_tabbar"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_12"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="@dimen/sk_touch"
            android:layout_height="@dimen/sk_touch"
            android:layout_gravity="center"
            android:background="@drawable/sk_tab"
            android:contentDescription="홈"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_home"
            android:stateListAnimator="@null"
            android:tint="@color/sk_tab_tint" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="@dimen/sk_touch"
            android:layout_height="@dimen/sk_touch"
            android:layout_gravity="center"
            android:background="@drawable/sk_tab"
            android:contentDescription="보내기"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_send"
            android:stateListAnimator="@null"
            android:tint="@color/sk_tab_tint" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/nav_devices"
            android:layout_width="@dimen/sk_touch"
            android:layout_height="@dimen/sk_touch"
            android:layout_gravity="center"
            android:background="@drawable/sk_tab"
            android:contentDescription="내 기기"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_devices"
            android:stateListAnimator="@null"
            android:tint="@color/sk_tab_tint" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/nav_settings"
            android:layout_width="@dimen/sk_touch"
            android:layout_height="@dimen/sk_touch"
            android:layout_gravity="center"
            android:background="@drawable/sk_tab"
            android:contentDescription="설정"
            android:padding="@dimen/space_10"
            android:src="@drawable/ic_settings"
            android:stateListAnimator="@null"
            android:tint="@color/sk_tab_tint" />
    </FrameLayout>

</LinearLayout>
