<resources>
    <style name="TextAppearance.AnyPaste.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:textColor">@color/ink_tertiary</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.AnyPaste.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineHeight">42sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="TextAppearance.AnyPaste.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">32sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.AnyPaste.TopNavigation" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">27sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.AnyPaste.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.AnyPaste.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">23sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.AnyPaste.BodyStrong" parent="TextAppearance.AnyPaste.Body">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="TextAppearance.AnyPaste.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">19sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.AnyPaste.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:stateListAnimator">@animator/dashboard_press</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
        <item name="iconPadding">@dimen/space_8</item>
        <item name="iconTint">@color/on_brand</item>
    </style>

    <style name="Widget.AnyPaste.Button.Secondary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:stateListAnimator">@animator/dashboard_press</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
        <item name="iconPadding">@dimen/space_8</item>
        <item name="iconTint">@color/ink</item>
    </style>

    <style name="Widget.AnyPaste.Button.Outline" parent="Widget.AnyPaste.Button.Secondary">
        <item name="android:background">@drawable/bg_button_outline</item>
    </style>

    <style name="Widget.AnyPaste.Button.Critical" parent="Widget.AnyPaste.Button.Primary">
        <item name="android:background">@drawable/bg_button_critical</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="iconTint">@color/on_brand</item>
    </style>

    <style name="Widget.AnyPaste.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_variant</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="errorTextColor">@color/danger_foreground</item>
        <item name="hintEnabled">false</item>
        <item name="hintTextColor">@color/ink_placeholder</item>
    </style>

    <style name="Widget.AnyPaste.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_placeholder</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.AnyPaste.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="switchMinWidth">48dp</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>
</resources>
