<resources>
    <style name="TextAppearance.AnyPaste.Overline" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AnyPaste.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AnyPaste.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.AnyPaste.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="iconTint">@color/white</item>
        <item name="cornerRadius">@dimen/radius_s</item>
    </style>

    <style name="Widget.AnyPaste.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="backgroundTint">@color/primary_container</item>
        <item name="iconTint">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_s</item>
    </style>

    <style name="Widget.AnyPaste.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="strokeColor">@color/line</item>
        <item name="cornerRadius">@dimen/radius_s</item>
    </style>
</resources>
