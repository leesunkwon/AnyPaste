<resources>
    <style name="Base.Theme.ViaOs" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sk_solid</item>
        <item name="colorPrimaryVariant">@color/sk_solid_hover</item>
        <item name="colorPrimaryDark">@color/sk_solid</item>
        <item name="colorOnPrimary">@color/sk_solid_fg</item>
        <item name="colorSecondary">@color/sk_solid</item>
        <item name="colorOnSecondary">@color/sk_solid_fg</item>
        <item name="colorError">@color/sk_warning</item>
        <item name="colorOnError">@color/sk_fg_on_danger</item>
        <item name="colorSurface">@color/sk_bg_elevated</item>
        <item name="colorOnSurface">@color/sk_fg</item>
        <item name="colorControlActivated">@color/sk_solid</item>
        <item name="colorControlNormal">@color/sk_fg_muted</item>
        <item name="colorAccent">@color/sk_solid</item>
        <item name="textInputStyle">@style/Widget.ViaOs.TextInputLayout</item>
        <item name="switchStyle">@style/Widget.ViaOs.Switch</item>
        <item name="android:colorAccent">@color/sk_solid</item>
        <item name="android:colorBackground">@color/sk_bg</item>
        <item name="android:colorControlHighlight">@color/sk_bg_muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/sk_bg</item>
        <item name="android:textColorPrimary">@color/sk_fg</item>
        <item name="android:textColorSecondary">@color/sk_fg_muted</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/sk_bg</item>
        <item name="android:navigationBarColor">@color/sk_bg</item>
    </style>

    <style name="Theme.ViaOs" parent="Base.Theme.ViaOs" />
</resources>
